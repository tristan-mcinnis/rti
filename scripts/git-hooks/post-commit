#!/bin/bash
# Installed by scripts/install-git-hooks.sh. Publish only this repo's clean main.
set -euo pipefail
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
[[ "$branch" == "main" ]] || exit 0
if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  echo "Auto-push skipped: working tree is not clean. Commit remains local." >&2
  exit 0
fi
origin="$(git remote get-url --push origin 2>/dev/null || true)"
case "$origin" in
  https://github.com/tristan-mcinnis/rti.git|git@github.com:tristan-mcinnis/rti.git) ;;
  *) echo "Auto-push refused: origin is not the approved repository. Commit remains local." >&2; exit 1 ;;
esac
echo "Auto-push: running publish checks; this can take several minutes."
if ! git push --porcelain origin HEAD:refs/heads/main; then
  echo "Auto-push failed. Commit remains local; inspect the failure before retrying." >&2
  exit 1
fi
