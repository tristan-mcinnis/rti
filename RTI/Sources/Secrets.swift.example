import Foundation

// Copy this file to Secrets.swift on first checkout.
// Secrets.swift is gitignored — never commit real keys.
//
// All API keys live in the macOS Keychain (managed by CredentialStore).
// The Settings sheet is the canonical way to enter them. The `_legacy*`
// fields below are read once on first launch by
// `CredentialStore.migrateLegacyIfNeeded()` to seed the Keychain, then
// ignored. Leave them as empty strings unless you're bootstrapping a key
// from outside the app.
enum Secrets {
    static var deepseekAPIKey: String { CredentialStore.deepseek ?? "" }
    static var sonioxAPIKey: String { CredentialStore.soniox ?? "" }

    static let _legacyDeepSeekKey = ""
    static let _legacySonioxKey = ""
}
